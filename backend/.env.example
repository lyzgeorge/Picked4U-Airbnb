API_TOKEN=change-me                  # sent by the extension as X-Api-Token
ADMIN_TOKEN=change-me-too            # required for upload
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_BATCH=128                      # texts per embedding request (SiliconFlow bge-m3 accepts 128); lower it if rejected
RERANK_MODEL=                        # optional, e.g. BAAI/bge-reranker-v2-m3; empty = off
LLM_PROTOCOL=openai_responses        # or anthropic_messages, or google_genai (AI Studio key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_REASONING_EFFORT=none             # none | low | medium | high. none is fastest (Gemini: none = MINIMAL thinking). Empty = model default
REVIEW_YEARS=2
SIM_THRESHOLD=0.66                   # a review supports a wish if its best sentence reaches this cosine; tune with scripts/calibrate.py
AVOID_SIM=0.72                       # a review sentence "mentions" an avoided thing at or above this cosine
LANCE_PATH=/data/lancedb
